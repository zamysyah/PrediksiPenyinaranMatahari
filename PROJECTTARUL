        "\n",
        "# Function to identify potential anomalies based on frequency. Customize thresholds as needed.\n",
        "def find_anomalies_by_frequency(unique_value_counts, threshold_percentage=1):\n",
        "    \"\"\"\n",
        "    Identifies potential anomalies based on the frequency of unique values.\n",
        "\n",
        "    Args:\n",
        "        unique_value_counts: Output of the detect_unique_values function.\n",
        "        threshold_percentage: Percentage threshold below which a unique value is considered an anomaly.\n",
        "\n",
        "    Returns:\n",
