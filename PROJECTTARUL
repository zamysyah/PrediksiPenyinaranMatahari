        "# prompt: mengecek nilai anomali dan unik\n",
        "\n",
        "# Assuming 'dataset' is already defined and preprocessed as in the provided code.\n",
        "\n",
        "def detect_unique_values(df):\n",
        "    \"\"\"\n",
        "    Identifies unique values and their counts in a Pandas DataFrame.\n",
        "\n",
        "    Args:\n",
        "        df: The input DataFrame.\n",
        "\n",
        "    Returns:\n",
        "        A dictionary where keys are column names and values are dictionaries\n",
        "        containing unique values as keys and their counts as values.\n",
        "    \"\"\"\n",
        "    unique_value_counts = {}\n",
        "    for col in df.columns:\n",
        "        unique_values = df[col].value_counts().to_dict()\n",
        "        unique_value_counts[col] = unique_values\n",
        "    return unique_value_counts\n",
