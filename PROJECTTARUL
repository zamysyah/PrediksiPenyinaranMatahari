        "import tensorflow as tf\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "\n",
        "# Pastikan data diurutkan berdasarkan tanggal\n",
        "dataset = dataset.sort_values(by='TANGGAL')\n",
        "\n",
        "# Normalisasi fitur (karena LSTM sensitif terhadap skala data)\n",
        "scaler = MinMaxScaler()\n",
        "scaled_features = scaler.fit_transform(dataset.drop(columns=['SS', 'TANGGAL']))  # Normalisasi fitur kecuali target dan tanggal\n",
        "\n",
        "# Menentukan panjang window (berapa banyak data sebelumnya yang digunakan untuk prediksi)\n",
        "window_size = 10  # Misalnya, gunakan 10 hari terakhir untuk memprediksi hari ke-11\n",
        "\n",
        "# Fungsi untuk membentuk dataset dengan windowing\n",
        "def create_lstm_dataset(features, target, window_size):\n",
        "    X_lstm, y_lstm = [], []\n",
        "    for i in range(len(features) - window_size):\n",
        "        X_lstm.append(features[i:i+window_size])  # Ambil window_size baris sebagai input\n",
        "        y_lstm.append(target[i+window_size])  # Target adalah nilai SS berikutnya\n",
        "    return np.array(X_lstm), np.array(y_lstm)\n",
        "\n",
        "# Buat dataset untuk LSTM\n",
        "X_lstm, y_lstm = create_lstm_dataset(scaled_features, dataset['SS'].values, window_size)\n",
        "\n",
        "# Split menjadi training dan testing\n",
        "split_ratio = 0.8\n",
        "split_index = int(len(X_lstm) * split_ratio)\n",
        "\n",
        "X_train_lstm, X_test_lstm = X_lstm[:split_index], X_lstm[split_index:]\n",
        "y_train_lstm, y_test_lstm = y_lstm[:split_index], y_lstm[split_index:]\n",
        "\n",
        "# Bentuk akhir untuk LSTM harus (samples, timesteps, features)\n",
        "print(\"Shape X_train LSTM:\", X_train_lstm.shape)  # Harus (jumlah sampel, window_size, jumlah fitur)\n",
        "print(\"Shape y_train LSTM:\", y_train_lstm.shape)\n"
